{
  "name": "shinzi",
  "productName": "Shinzi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "deploy:rules": "node scripts/deploy-firestore-rules.cjs",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.1",
    "@capacitor/push-notifications": "^6.0.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.4",
    "@mui/material": "^9.5.0",
    "emoji-picker-react": "^5.1.4",
    "emojibase-data": "^18.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.5.0",
    "lucide-react": "^0.468.0",
    "primeicons": "^8.0.2",
    "primereact": "^9.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-speech-recognition": "^4.0.1",
    "regenerator-runtime": "^0.14.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-speech-recognition": "^3.9.6",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.shinzi.desktop",
    "productName": "Shinzi",
    "directories": {
      "output": "build-desktop"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shinzi"
    }
  }
}
